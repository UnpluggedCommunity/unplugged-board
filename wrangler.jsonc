{
	// Cloudflare Workers config. Public values only — secrets go in the Cloudflare dashboard.
	"name": "unplugged-board",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"vars": {
		"PUBLIC_SUPABASE_URL": "https://anmuomzzagytuxhcsysm.supabase.co",
		"PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hMEuwLY-T4lijg4a0FnJjg_upmYAOGS"
	},
	// Preview builds (non-main branches) use the same public values: there is one Supabase project.
	"previews": {
		"vars": {
			"PUBLIC_SUPABASE_URL": "https://anmuomzzagytuxhcsysm.supabase.co",
			"PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hMEuwLY-T4lijg4a0FnJjg_upmYAOGS"
		}
	}
}
